#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// Miryoku's own hold-tap tuning (tap-preferred, 200ms), applied to both the
// built-in layer-tap behavior and our home-row-mod behavior below. quick-tap-ms
// is a deviation from stock Miryoku (which defines none): tap then quickly
// press-and-hold again within this window to repeat the tap key normally,
// instead of re-triggering the hold-tap decision — needed since tap-hold keys
// can't auto-repeat on their own while held.
&lt { tapping-term-ms = <200>; flavor = "tap-preferred"; quick-tap-ms = <175>; };

/ {
    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <100>;
        };

        no_encoder: no_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };

        // Miryoku's RGB shift-functions: tap = increase/next, shift+tap = decrease/off.
        rgb_eff_morph: rgb_eff_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_hue_morph: rgb_hue_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_sat_morph: rgb_sat_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_SAD>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_bri_morph: rgb_bri_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_tog_morph: rgb_tog_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_TOG>, <&rgb_ug RGB_OFF>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Miryoku (github.com/manna-harbour/miryoku), QWERTY alphas, transcribed from
        // the canonical reference (manna-harbour/miryoku_zmk, non-flip, default Nav/
        // clipboard/mousekeys variants), then hand-inverted: the FLIP variant's hold
        // targets and mirrored per-layer content are used, but the thumb tap keycodes
        // are kept at their original (non-flip) physical positions (ESC/SPACE/TAB left,
        // RET/BSPC/DEL right) instead of FLIP's own mirrored tap keycodes.
        // Simplifications from stock Miryoku:
        //   - Single alpha layer only (no Extra/Tap alternate-base switching).
        //   - Per-layer "layer lock" toggle corners and the Base-return (&to 0) corner
        //     dropped entirely (kept plain &bootloader) — nothing in this simplified
        //     keymap can leave you off Base, so the escape hatch had no failure mode left.
        //   - RGB/BT/output shift-combo tricks (e.g. shift+BT_SEL=clear) not implemented;
        //     plain selects/toggles used instead.
        // Outer pinky column (this board's 6th column, not part of stock Miryoku) keeps
        // this session's own scheme, paired by thumb reach-tier across hands:
        //   Base = -/=.  Num+Nav (mid-reach) = ( / ).  Sym+Mouse (outer-reach) = [ / ].
        //   Fun+Media (inner-reach) = { / }.  Button = unused (no stock Miryoku content).
        // Joystick and encoder kept exactly as on main, reassigned by layer PURPOSE
        // (not by which thumb key now triggers it): Base=mouse/vol, Nav=nav keys/pgup-dn,
        // Num=arrows+Enter/none, Sym=scroll+Rclick/none, Media=none/RGB effect+toggle,
        // Fun=none/none, Mouse=none/scroll, Button=none/none.
        // Thumbs (tap keycode unchanged, hold target inverted):
        //   L=ESC(Fun)/SPACE(Num)/TAB(Sym)  R=RET(Mouse)/BSPC(Nav)/DEL(Media)
        default_layer {
            display-name = "Base";
            bindings = <
&kp MINUS  &kp Q  &kp W  &kp E  &kp R  &kp T                                   &mmv MOVE_UP              &kp Y  &kp U  &kp I  &kp O  &kp P            &kp EQUAL
&trans  &hrm LGUI A  &hrm LALT S  &hrm LCTRL D  &hrm LSHFT F  &kp G              &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp H  &hrm LSHFT J  &hrm LCTRL K  &hrm LALT L  &hrm LGUI SEMI   &trans
&trans  &lt 7 Z  &hrm RALT X  &kp C  &kp V  &kp B       &kp C_MUTE &mmv MOVE_DOWN          &kp N  &kp M  &kp COMMA  &hrm RALT DOT  &lt 7 SLASH    &trans
                                &lt 5 ESC  &lt 2 SPACE  &lt 3 TAB   &lt 6 RET  &lt 1 BSPC  &lt 4 DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&kp LPAR  &kp K_UNDO  &kp LS(DEL)  &kp LC(INS)  &kp LS(INS)  &kp K_AGAIN                                   &kp PG_UP              &none  &none  &none  &none  &bootloader            &kp RPAR
&trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &caps_word              &kp HOME  &none  &kp END  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI   &trans
&trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp INS       &none &kp PG_DN          &none  &none  &none  &kp RALT  &none    &trans
                                &kp DEL  &kp BSPC  &kp RET   &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp LPAR  &bootloader  &none  &none  &none  &none                                   &kp UP              &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT            &kp RPAR
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none              &kp LEFT  &kp RET  &kp RIGHT  &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp SQT   &trans
&trans  &none  &kp RALT  &none  &none  &none       &none &kp DOWN          &kp BSLH  &kp N1  &kp N2  &kp N3  &kp GRAVE    &trans
                                &none  &none  &none   &kp MINUS  &kp N0  &kp DOT
            >;
            sensor-bindings = <&no_encoder>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp LBKT  &bootloader  &none  &none  &none  &none                                   &msc SCRL_UP              &kp LBRC  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC            &kp RBKT
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none              &msc SCRL_LEFT  &mkp RCLK  &msc SCRL_RIGHT  &kp PLUS  &kp DLLR  &kp PRCNT  &kp CARET  &kp COLON   &trans
&trans  &none  &kp RALT  &none  &none  &none       &none &msc SCRL_DOWN          &kp PIPE  &kp EXCL  &kp AT  &kp HASH  &kp TILDE    &trans
                                &none  &none  &none   &kp UNDER  &kp LPAR  &kp RPAR
            >;
            sensor-bindings = <&no_encoder>;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&kp LBRC  &rgb_eff_morph  &rgb_hue_morph  &rgb_sat_morph  &rgb_bri_morph  &rgb_tog_morph                                   &none              &none  &none  &none  &none  &bootloader            &kp RBRC
&trans  &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &ext_power EP_TOG              &none  &none  &none  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI   &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &out OUT_TOG       &rgb_ug RGB_TOG &none          &none  &none  &none  &kp RALT  &none    &trans
                                &kp C_MUTE  &kp C_PP  &kp C_STOP   &none  &none  &none
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp LBRC  &bootloader  &none  &none  &none  &none                                   &kp LG(PG_UP)              &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12            &kp RBRC
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none              &kp LG(J)  &none  &kp LG(K)  &kp SCROLLLOCK  &kp F4  &kp F5  &kp F6  &kp F11   &trans
&trans  &none  &kp RALT  &none  &none  &none       &none &kp LG(PG_DN)          &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10    &trans
                                &none  &none  &none   &kp TAB  &kp SPACE  &kp K_APP
            >;
            sensor-bindings = <&no_encoder>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&kp LBKT  &kp K_UNDO  &kp LS(DEL)  &kp LC(INS)  &kp LS(INS)  &kp K_AGAIN                                   &none              &none  &none  &none  &none  &bootloader            &kp RBKT
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none              &none  &none  &none  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI   &trans
&trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none       &none &none          &none  &none  &none  &kp RALT  &none    &trans
                                &mkp MB3  &mkp MB1  &mkp MB2   &none  &none  &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        button_layer {
            display-name = "Button";
            bindings = <
&none  &kp K_UNDO  &kp LS(DEL)  &kp LC(INS)  &kp LS(INS)  &kp K_AGAIN                                   &none              &kp K_AGAIN  &kp LS(INS)  &kp LC(INS)  &kp LS(DEL)  &kp K_UNDO            &none
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none              &none  &none  &none  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI   &trans
&trans  &kp K_UNDO  &kp LS(DEL)  &kp LC(INS)  &kp LS(INS)  &kp K_AGAIN       &none &none          &kp K_AGAIN  &kp LS(INS)  &kp LC(INS)  &kp LS(DEL)  &kp K_UNDO    &trans
                                &mkp MB3  &mkp MB1  &mkp MB2   &mkp MB2  &mkp MB1  &mkp MB3
            >;
            sensor-bindings = <&no_encoder>;
        };
    };
};
