#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// Tap a thumb layer-tap key, then press-and-hold it again within this window
// to repeat the tap keycode (e.g. hold Backspace) instead of activating its layer.
&lt { quick-tap-ms = <175>; };

/ {
    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            display-name = "V/Refresh";
            #binding-cells = <0>;
            tapping-term-ms = <230>;
            bindings = <&kp V>, <&kp LC(R)>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <100>;
        };

        no_encoder: no_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Cheapino base layer migrated to 6-col Corne.
        // Outer pinky column, top row, paired by thumb reach-tier across hands:
        //   Base = -/=.  Num+Nav (mid-reach) = ( / ).  Sym+Mouse (outer-reach) = [ / ].  Fn+Sys (inner-reach) = { / }.
        // Home: Caps Word / GUI+F9. Bottom: GUI+SPACE / GUI+RET.
        // Joystick (5-way), per held thumb layer:
        //   Base:  move mouse, press = left click.
        //   Num:   arrow keys, press = Enter.
        //   Sym:   scroll, press = right click.
        //   Nav:   PgUp/PgDn/Home/End, press = none.
        //   Fn:    none.
        //   Sys:   none.
        //   Mouse: none (use SPACE/TAB thumb keys for clicks instead).
        // Thumbs: L=ESC(L3)/SPC(L2)/TAB(L5)  R=DEL(L4)/BSPC(L1)/RET(L6=Mouse)
        default_layer {
            display-name = "Base";
            bindings = <
&kp MINUS  &kp Q        &kp W        &kp E        &kp R        &kp T                                   &mmv MOVE_UP              &kp Y      &kp U        &kp I         &kp O          &kp P            &kp EQUAL
&caps_word  &hrm LGUI A  &hrm LALT S  &hrm LCTL D  &hrm LSHFT F &kp G              &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp H      &hrm RSHFT J &hrm RCTL K   &hrm LALT L    &hrm RGUI SEMI   &kp LG(F9)
&kp LG(SPACE)  &lt 4 Z      &hrm RALT X  &kp C        &td_v        &kp B    &kp C_MUTE         &mmv MOVE_DOWN          &kp N      &kp M        &kp COMMA     &hrm RALT DOT  &kp FSLH         &kp LG(RET)
                                  &lt 3 ESC    &lt 2 SPACE  &lt 5 TAB                               &lt 4 DEL  &lt 1 BSPC   &lt 6 RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Nav layer (hold BSPC right-mid thumb).
        // Left: navigation cluster. Right: same-hand mods for nav combos.
        nav_layer {
            display-name = "Nav";
            bindings = <
&kp LPAR  &kp PG_UP  &kp HOME  &kp UP    &kp END   &kp INS                               &kp PG_UP                    &none  &none   &none   &none   &none  &kp RPAR
&trans  &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp CAPS          &kp HOME  &none  &kp END  &none  &kp RSHFT &kp RCTL &kp LALT &kp RGUI &trans
&trans  &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &kp K_AGAIN  &none             &kp PG_DN          &none  &none   &none   &none   &none  &trans
                        &none   &none   &none                                   &none        &trans     &none
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        // Num layer (hold SPACE left-mid thumb).
        // Right: numpad layout. Left: workspace switchers + OS mods.
        num_layer {
            display-name = "Num";
            bindings = <
&kp LPAR  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)                              &kp UP              &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT  &kp RPAR
&trans  &kp LGUI    &kp LALT    &kp LCTL    &kp LSHFT   &none              &kp LEFT  &kp RET  &kp RIGHT  &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp SQT   &trans
&trans  &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &none          &kp DOWN          &kp MINUS  &kp N1  &kp N2  &kp N3  &kp BSLH  &trans
                                &none       &trans      &none                                       &kp GRAVE  &kp DOT &kp N0
            >;
            sensor-bindings = <&no_encoder>;
        };

        // Sym layer (hold ESC left-mid thumb).
        // Right: symbols (shifted pairs of Num layer). Left: workspace switchers + OS mods.
        sym_layer {
            display-name = "Sym";
            bindings = <
&kp LBKT  &none       &none       &none       &none       &none                                   &msc SCRL_UP                    &kp LBRC    &kp AMPS   &kp ASTRK  &kp LPAR   &kp RBRC  &kp RBKT
&trans  &kp LGUI    &kp LALT    &kp LCTL    &kp LSHFT   &none              &msc SCRL_LEFT  &mkp RCLK  &msc SCRL_RIGHT  &kp KP_PLUS &kp DLLR   &kp PRCNT  &kp CARET  &kp DQT   &trans
&trans  &none       &none       &none       &none       &none       &none          &msc SCRL_DOWN          &kp UNDER   &kp EXCL   &kp AT     &kp HASH   &kp PIPE  &trans
                                &none       &none       &trans                                      &kp TILDE   &kp LPAR   &kp RPAR
            >;
            sensor-bindings = <&no_encoder>;
        };

        // Sys layer (hold DEL right-outer thumb, or Z on the left hand).
        // Left: bootloader, reset, studio unlock. Right: BT channel select (top row from U),
        // output select / BT clear (bottom row from M), plus same-hand mods.
        // Joystick: none.
        // Encoder: rotate = RGB effect prev/next, click = RGB toggle.
        sys_layer {
            display-name = "Sys";
            bindings = <
&kp LBRC  &none  &none  &none  &none  &bootloader                          &none                    &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp RBRC
&trans  &none  &none  &none  &none  &studio_unlock   &none  &none  &none  &none   &kp RSHFT  &kp RCTL  &kp LALT    &kp RGUI &trans
&trans  &none    &none    &none      &none    &sys_reset   &rgb_ug RGB_TOG &none          &none   &out OUT_USB         &out OUT_BLE         &bt BT_CLR    &bt BT_CLR_ALL    &trans
                                    &none         &none         &none                                   &trans  &none         &none
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        // Fn layer (hold TAB left-outer thumb).
        // Right: function keys. Left: OS mods (home row), media transport (bottom row).
        fn_layer {
            display-name = "Fn";
            bindings = <
&kp LBRC  &none       &none       &none       &none       &none                              &none                    &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12           &kp RBRC
&trans  &kp LGUI    &kp LALT    &kp LCTL    &kp LSHFT   &none                  &none  &none  &none  &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11           &trans
&trans  &kp C_PREV       &kp C_STOP       &kp C_PP       &kp C_NEXT       &none        &none          &none          &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10           &trans
                                &trans      &none       &none                                       &none            &none   &none
            >;
            sensor-bindings = <&no_encoder>;
        };

        // Mouse layer (hold RET right-inner thumb).
        // Left: mouse movement mirroring Nav layer's arrow-cluster positions (up on E, left/down/right on S/D/F).
        // Thumbs: SPACE = left click, TAB = right click. Right hand: same-hand mods only.
        // Joystick: none. Encoder: scroll down/up, click = none.
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&kp LBKT  &none  &none  &mmv MOVE_UP  &none  &none                              &none                    &none  &none  &none  &none  &none  &kp RBKT
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none                  &none  &none  &none  &none   &kp RSHFT  &kp RCTL  &kp LALT  &kp RGUI  &trans
&none  &none  &none  &none  &none  &none        &none          &none          &none  &none  &none  &none  &none  &trans
                                &none      &mkp LCLK   &mkp RCLK                                   &none  &none  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
